cabal-version:      3.12
name:               pleh
version:            0.1.0.0
license:            BSD-2-Clause
author:             gusutabo
maintainer:         gustavolinssm@gmail.com
build-type:         Simple
extra-doc-files:    README.md

common warnings
    ghc-options: -Wall

library
    import:           warnings
    exposed-modules:  Logic
                    , Parser
    build-depends:    base ^>=4.20.2.0
    hs-source-dirs:   src
    default-language: Haskell2010

executable pleh
    import:           warnings
    main-is:          Main.hs
    build-depends:    base ^>=4.20.2.0
                    , pleh
    hs-source-dirs:   app
    default-language: Haskell2010

test-suite pleh-test
    import:           warnings
    type:             exitcode-stdio-1.0
    main-is:          Spec.hs
    build-depends:    base ^>=4.20.2.0
                    , hspec >=2.7 && <3
                    , QuickCheck >=2.14 && <3
                    , pleh
    hs-source-dirs:   test
    default-language: Haskell2010
